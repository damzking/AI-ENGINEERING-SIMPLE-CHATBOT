      "position": [
        420,
        240
      ],
      "id": "bb98df0a-1c72-44d3-9a10-9a6425ecda72",
      "name": "Calculator"
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst answer = result.output;\nconst request = $('Chat Webhook').first().json.body;\n\nif (typeof answer !== 'string' || answer.trim() === '') {\n  throw new Error('The Gemini AI Agent returned an empty answer. Check the Agent and Gemini model configuration.');\n}\nif (!Array.isArray(request.sources)) {\n  throw new Error('The webhook request did not include a valid sources array.');\n}\n\nreturn [{\n  json: {\n    answer: answer.trim(),\n    sources: request.sources,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "id": "197cfd4f-a9ad-4a72-b072-109d3f3efc38",
      "name": "Format Answer"
    },
