        "options": {
          "temperature": 0
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        220,
        240
      ],
      "id": "1e3b4f91-ec1d-4cb7-90c2-1f64d7b30e52",
