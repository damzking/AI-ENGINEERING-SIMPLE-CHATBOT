      "parameters": {
        "promptType": "define",
        "text": "=Question: {{ $json.body.question }}\n\nRetrieved PDF excerpts:\n{{ $json.body.context }}",
        "options": {
          "systemMessage": "Answer the user's question using only the supplied PDF excerpts. If the excerpts do not contain the answer, say you could not find it in the PDF. Do not use outside knowledge. If arithmetic is needed to answer a question based on the excerpts, use the Calculator tool. Be concise and do not invent facts or citations."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [
        260,
        0
      ],
      "id": "a3d2b869-52e4-448a-a3d8-9f6340a3ab91",
